  arxiv        = {2506.08059},
  abstract     = {Caco-2 permeability serves as a critical in vitro indicator to predict oral absorption of drug candidates during early-stage drug discovery. We assessed model performance across molecular representations on two datasets of differing scale and diversity, identifying PaDEL, Mordred, and RDKit descriptors as particularly effective. The AutoML-based model CaliciBoost achieved the best MAE performance.},
